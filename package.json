{
  "name": "dct-ai-independent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:integrity && prisma generate && next build",
    "vercel-build": "npm run verify:integrity && prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "verify:integrity": "node scripts/verify-integrity.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@upstash/redis": "^1.38.1",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "prisma": "^6.19.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
