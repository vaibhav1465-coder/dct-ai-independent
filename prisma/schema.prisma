generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOURNALIST
  ADMIN
}

enum CheckStatus {
  SUCCEEDED
  FAILED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  image         String?
  role          Role            @default(JOURNALIST)
  accounts      Account[]
  sessions      Session[]
  checks        CheckMetadata[]
  feedback      Feedback[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CheckMetadata {
  id                  String      @id @default(cuid())
  userId              String
  user                User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  publication         String
  headline            String?     @db.VarChar(240)
  subhead             String?     @db.VarChar(280)
  articleLabel        String?     @db.VarChar(120)
  articleContent      String?     @db.Text
  outputContent       String?     @db.Text
  wordCount           Int
  durationMs          Int
  provider            String
  model               String
  status              CheckStatus
  failureCategory     String?
  verdict             String?
  primaryCategory     String?
  reliability         String?
  inputTokens         Int?
  outputTokens        Int?
  estimatedCostMicros Int?
  aiDetectionScore    Float?
  aiDetectionPassed   Boolean?
  aiDetectionProvider String?
  aiDetectionModel    String?
  aiHeadlineScore     Float?
  aiBodyScore         Float?
  aiDetectionThreshold Float?
  cviVerdict          String?
  cviAction           String?
  createdAt           DateTime    @default(now())
  feedback            Feedback?

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([aiDetectionPassed, createdAt])
}

model Feedback {
  id        String        @id @default(cuid())
  checkId   String        @unique
  check     CheckMetadata @relation(fields: [checkId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  rating    Int
  comment   String?       @db.VarChar(500)
  createdAt DateTime      @default(now())
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  event     String
  outcome   String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key            String   @id
  publicValue    String?
  encryptedValue String?
  updatedBy      String
  updatedAt      DateTime @updatedAt
}
